# Copy this file to `.env` (kept out of git) and fill in your values.
# These configure the local OpenAI-compatible model endpoint.
#
# Examples for base URL:
#   Ollama     -> http://localhost:11434/v1
#   LM Studio  -> http://localhost:1234/v1
#   llama.cpp  -> http://localhost:8080/v1

DIP_LLM_BASE_URL=http://localhost:11434/v1
DIP_LLM_API_KEY=not-needed-for-local
DIP_LLM_MODEL=qwen2.5-coder

# Output token cap. Raise for big structured outputs (plans, patches, research).
# Reasoning models (gpt-oss) spend tokens "thinking" first, so give them plenty.
DIP_LLM_MAX_TOKENS=4096

# Reasoning models only (e.g. gpt-oss): low | medium | high. "low" leaves more
# room for the actual answer. Leave unset for non-reasoning models.
# DIP_LLM_REASONING_EFFORT=low
